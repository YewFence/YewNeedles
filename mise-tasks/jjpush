#!/usr/bin/env python
# MISE description "Set a jj bookmark to the previous change and push"
# USAGE arg "[bookmark]" help="Bookmark name to set before pushing, default main"

from __future__ import annotations

import os
import subprocess


def run(args: list[str]) -> None:
    subprocess.run(args, check=True)


def main() -> None:
    bookmark = os.environ.get("usage_bookmark") or "main"

    run(["jj", "bookmark", "set", bookmark, "-r", "@-"])
    run(["jj", "git", "push"])


if __name__ == "__main__":
    main()
