#!/usr/bin/env python
#MISE description="Scan Atuin history with betterleaks and record local secret findings"
#USAGE flag "--after <datetime>" help="Only scan entries after this timestamp, filtered from Atuin output"
#USAGE flag "--limit <count>" help="Scan at most this many entries after state and time filtering"
#USAGE flag "--state-dir <path>" help="State directory, defaults to ~/.local/state/atuin-betterleaks"
#USAGE flag "--timeout <seconds>" help="Timeout passed to betterleaks, defaults to 0"
#USAGE flag "--full-scan" help="Ignore the stored latest uuid and scan all listed entries"
#USAGE flag "--history-file <path>" help="Read exported Atuin rows from a file instead of running atuin, use - for stdin"
#USAGE flag "--no-notify" help="Disable notify-send alerts"
#USAGE flag "--fail-on-findings" help="Exit with betterleaks-style code 93 when findings are recorded"

from __future__ import annotations

import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
from dataclasses import dataclass
from datetime import date, datetime
from pathlib import Path
from typing import Any

LEAK_EXIT_CODE = 93
DEFAULT_STATE_DIR = "~/.local/state/atuin-betterleaks"
ATUIN_FORMAT = "{uuid}\\t{time}\\t{directory}\\t{command}"


@dataclass(frozen=True)
class HistoryEntry:
    uuid: str
    time: str
    directory: str
    command: str


def eprint(message: str) -> None:
    print(message, file=sys.stderr)


def is_true(name: str) -> bool:
    return os.environ.get(name, "false") == "true"


def usage_value(name: str, default: str = "") -> str:
    return os.environ.get(f"usage_{name}", default).strip()


def require_command(name: str, install_hint: str) -> None:
    if shutil.which(name) is not None:
        return

    eprint(f"{name} 不在 PATH 里。{install_hint}")
    raise SystemExit(1)


def state_dir() -> Path:
    return Path(usage_value("state_dir", DEFAULT_STATE_DIR)).expanduser()


def parse_positive_int(name: str) -> int | None:
    value = usage_value(name)
    if not value:
        return None

    try:
        parsed = int(value)
    except ValueError as error:
        eprint(f"{name} 必须是整数。当前值是 {value!r}")
        raise SystemExit(1) from error

    if parsed < 1:
        eprint(f"{name} 必须大于 0。当前值是 {value!r}")
        raise SystemExit(1)

    return parsed


def load_state(path: Path) -> dict[str, Any]:
    try:
        raw_state = path.read_text(encoding="utf-8")
    except FileNotFoundError:
        return {}

    if not raw_state.strip():
        return {}

    try:
        data = json.loads(raw_state)
    except json.JSONDecodeError as error:
        eprint(f"无法解析状态文件 {path}。{error}")
        raise SystemExit(1) from error

    if not isinstance(data, dict):
        eprint(f"状态文件格式不是 JSON 对象。{path}")
        raise SystemExit(1)

    return data


def write_json(path: Path, data: dict[str, Any]) -> None:
    temp_path = path.with_suffix(path.suffix + ".tmp")
    temp_path.write_text(
        json.dumps(data, ensure_ascii=False, sort_keys=True, indent=2) + "\n",
        encoding="utf-8",
    )
    temp_path.replace(path)


def append_jsonl(path: Path, records: list[dict[str, Any]]) -> None:
    if not records:
        return

    with path.open("a", encoding="utf-8") as file:
        for record in records:
            file.write(json.dumps(record, ensure_ascii=False, sort_keys=True) + "\n")


def run_atuin_history() -> bytes:
    require_command("atuin", "请先执行 MISE_OFFLINE=0 mise install atuin 或者 mise install。")
    args = [
        "atuin",
        "history",
        "list",
        "--format",
        ATUIN_FORMAT,
        "--reverse",
        "true",
        "--print0",
    ]

    result = subprocess.run(
        args,
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )

    if result.returncode == 0:
        return result.stdout

    stdout = result.stdout.decode("utf-8", errors="replace").strip()
    stderr = result.stderr.decode("utf-8", errors="replace").strip()
    if stdout:
        eprint(stdout)
    if stderr:
        eprint(stderr)
    raise SystemExit(result.returncode)


def read_history_input() -> bytes:
    history_file = usage_value("history_file")
    if history_file == "-":
        return sys.stdin.buffer.read()
    if history_file:
        return Path(history_file).expanduser().read_bytes()

    return run_atuin_history()


def split_history_records(raw_history: bytes) -> list[str]:
    if not raw_history:
        return []

    if b"\0" in raw_history:
        chunks = raw_history.split(b"\0")
    else:
        chunks = raw_history.splitlines()

    return [
        chunk.decode("utf-8", errors="replace")
        for chunk in chunks
        if chunk
    ]


def parse_history_record(record: str) -> HistoryEntry | None:
    parts = record.split("\t", 3)
    if len(parts) != 4:
        eprint("跳过无法解析的 Atuin 历史行。")
        return None

    uuid, item_time, directory, command = parts
    if not uuid:
        eprint("跳过 uuid 为空的 Atuin 历史行。")
        return None

    return HistoryEntry(uuid=uuid, time=item_time, directory=directory, command=command)


def parse_datetime(value: str) -> datetime | None:
    candidate = value.strip()
    if not candidate:
        return None

    if candidate.isdigit():
        try:
            return datetime.fromtimestamp(int(candidate)).astimezone()
        except (OverflowError, OSError, ValueError):
            return None

    if candidate.endswith("Z"):
        candidate = f"{candidate[:-1]}+00:00"

    try:
        return datetime.fromisoformat(candidate)
    except ValueError:
        pass

    try:
        return datetime.combine(date.fromisoformat(candidate), datetime.min.time())
    except ValueError:
        return None


def normalize_datetime(value: datetime, reference: datetime) -> datetime:
    local_tz = datetime.now().astimezone().tzinfo
    if value.tzinfo is None and reference.tzinfo is not None:
        return value.replace(tzinfo=local_tz)
    if value.tzinfo is not None and reference.tzinfo is None:
        return value.astimezone().replace(tzinfo=None)
    return value


def after_filter() -> datetime | None:
    value = usage_value("after")
    if not value:
        return None

    parsed = parse_datetime(value)
    if parsed is None:
        eprint(f"无法解析 after 时间。当前值是 {value!r}")
        raise SystemExit(1)

    return parsed


def should_scan_time(entry: HistoryEntry, after: datetime | None) -> bool:
    if after is None:
        return True

    entry_time = parse_datetime(entry.time)
    if entry_time is None:
        eprint(f"跳过时间无法解析的历史项。uuid 是 {entry.uuid}")
        return False

    return normalize_datetime(entry_time, after) > after


def filtered_entries(
    entries: list[HistoryEntry],
    state: dict[str, Any],
    after: datetime | None,
    limit: int | None,
) -> tuple[list[HistoryEntry], str | None, str | None, bool]:
    last_scanned_uuid = state.get("latest_scanned_uuid")
    if not isinstance(last_scanned_uuid, str):
        last_scanned_uuid = None

    full_scan = is_true("usage_full_scan")
    seen_stored_uuid = full_scan or last_scanned_uuid is None
    selected: list[HistoryEntry] = []
    latest_uuid: str | None = None
    latest_time: str | None = None

    for entry in entries:
        latest_uuid = entry.uuid
        latest_time = entry.time

        if not seen_stored_uuid:
            if entry.uuid == last_scanned_uuid:
                seen_stored_uuid = True
            continue

        if not should_scan_time(entry, after):
            continue

        selected.append(entry)
        if limit is not None and len(selected) >= limit:
            break

    return selected, latest_uuid, latest_time, seen_stored_uuid


def build_scan_input(entries: list[HistoryEntry]) -> tuple[str, list[HistoryEntry | None]]:
    chunks: list[str] = []
    line_to_entry: list[HistoryEntry | None] = [None]

    for entry in entries:
        chunks.append(f"{entry.command}\n")
        line_count = entry.command.count("\n") + 1
        line_to_entry.extend([entry] * line_count)

    return "".join(chunks), line_to_entry


def run_betterleaks(scan_input: str) -> list[dict[str, Any]]:
    require_command(
        "betterleaks",
        "请先执行 MISE_OFFLINE=0 mise install betterleaks 或者 mise install。",
    )

    timeout = usage_value("timeout", "0")
    args = [
        "betterleaks",
        "stdin",
        "--no-banner",
        "--no-color",
        "--redact=100",
        "--ignore-gitleaks-allow",
        "--report-path",
        "-",
        "--report-format",
        "json",
        "--exit-code",
        str(LEAK_EXIT_CODE),
        "--log-level",
        "fatal",
    ]

    if timeout:
        args.extend(["--timeout", timeout])

    result = subprocess.run(
        args,
        input=scan_input,
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )

    if result.returncode not in {0, LEAK_EXIT_CODE}:
        stdout = result.stdout.strip()
        stderr = result.stderr.strip()
        if stdout:
            eprint(stdout)
        if stderr:
            eprint(stderr)
        raise SystemExit(result.returncode)

    return parse_betterleaks_report(result.stdout)


def finding_start_line(finding: dict[str, Any]) -> int | None:
    line = finding.get("StartLine")
    if isinstance(line, int) and line > 0:
        return line
    return None


def findings_by_entry(
    findings: list[dict[str, Any]],
    line_to_entry: list[HistoryEntry | None],
) -> dict[str, tuple[HistoryEntry, list[dict[str, Any]]]]:
    grouped: dict[str, tuple[HistoryEntry, list[dict[str, Any]]]] = {}

    for finding in findings:
        line = finding_start_line(finding)
        if line is None or line >= len(line_to_entry):
            eprint("跳过无法映射回 Atuin 历史项的 betterleaks 发现。")
            continue

        entry = line_to_entry[line]
        if entry is None:
            eprint("跳过无法映射回 Atuin 历史项的 betterleaks 发现。")
            continue

        if entry.uuid not in grouped:
            grouped[entry.uuid] = (entry, [])
        grouped[entry.uuid][1].append(finding)

    return grouped


def parse_betterleaks_report(raw_report: str) -> list[dict[str, Any]]:
    report = raw_report.strip()
    if not report:
        return []

    try:
        data = json.loads(report)
    except json.JSONDecodeError:
        start = report.find("[")
        end = report.rfind("]")
        if start == -1 or end == -1 or end < start:
            eprint("无法从 betterleaks 输出中找到 JSON 数组。")
            raise SystemExit(1)
        try:
            data = json.loads(report[start : end + 1])
        except json.JSONDecodeError as error:
            eprint(f"无法解析 betterleaks JSON 报告。{error}")
            raise SystemExit(1) from error

    if data is None:
        return []

    if not isinstance(data, list):
        eprint("betterleaks JSON 报告格式不是数组。")
        raise SystemExit(1)

    return [item for item in data if isinstance(item, dict)]


def finding_type(finding: dict[str, Any]) -> str:
    for key in ("RuleID", "Rule", "DetectorName", "Description", "SecretType"):
        value = finding.get(key)
        if isinstance(value, str) and value:
            return value
    return "unknown"


def finding_types(findings: list[dict[str, Any]]) -> list[str]:
    return sorted({finding_type(finding) for finding in findings})


def redact_command(command: str) -> str:
    redacted = command
    redacted = re.sub(
        r"(?i)(password|passwd|pwd|token|secret|api[_-]?key|access[_-]?key)(=|\s+)(\S+)",
        r"\1\2[REDACTED]",
        redacted,
    )
    redacted = re.sub(
        r"(?i)(authorization:\s*bearer\s+)(\S+)",
        r"\1[REDACTED]",
        redacted,
    )
    redacted = re.sub(
        r"(?i)(--(?:password|token|secret|api-key|access-key)(?:=|\s+))(\S+)",
        r"\1[REDACTED]",
        redacted,
    )
    redacted = re.sub(
        r"(?i)(AWS_SECRET_ACCESS_KEY|AWS_ACCESS_KEY_ID|GITHUB_TOKEN|GH_TOKEN)=\S+",
        r"\1=[REDACTED]",
        redacted,
    )
    redacted = re.sub(r"[A-Za-z0-9_./+=-]{32,}", "[REDACTED]", redacted)
    redacted = " ".join(redacted.split())
    if len(redacted) > 240:
        return f"{redacted[:237]}..."
    return redacted


def report_record(entry: HistoryEntry, findings: list[dict[str, Any]]) -> dict[str, Any]:
    command_hash = hashlib.sha256(entry.command.encode("utf-8")).hexdigest()
    types = finding_types(findings)
    return {
        "atuin_uuid": entry.uuid,
        "atuin_time": entry.time,
        "command_sha256": command_hash,
        "command_summary": redact_command(entry.command),
        "delete_note": (
            "不要直接无人值守删除。确认后手动运行 "
            "atuin search --delete -- '<足够唯一且确认只命中目标历史的片段>'"
        ),
        "detected_at": datetime.now().astimezone().isoformat(timespec="seconds"),
        "directory": entry.directory,
        "finding_count": len(findings),
        "finding_types": types,
    }


def notify(message: str) -> None:
    if is_true("usage_no_notify"):
        return
    if shutil.which("notify-send") is None:
        return
    if not os.environ.get("DISPLAY") and not os.environ.get("WAYLAND_DISPLAY"):
        return

    subprocess.run(
        ["notify-send", "Atuin history secret detector", message],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def main() -> int:
    output_dir = state_dir()
    output_dir.mkdir(parents=True, exist_ok=True)
    state_path = output_dir / "state.json"
    findings_path = output_dir / "findings.jsonl"
    after = after_filter()
    limit = parse_positive_int("limit")
    state = load_state(state_path)

    raw_history = read_history_input()
    records = split_history_records(raw_history)
    entries = [
        entry
        for record in records
        if (entry := parse_history_record(record)) is not None
    ]
    entries_to_scan, latest_uuid, latest_time, seen_stored_uuid = filtered_entries(
        entries,
        state,
        after,
        limit,
    )

    if not seen_stored_uuid and state.get("latest_scanned_uuid"):
        eprint("没有在 Atuin 输出中找到上次记录的最新 uuid，本次改为扫描完整输出。")
        entries_to_scan, latest_uuid, latest_time, _ = filtered_entries(
            entries,
            {"latest_scanned_uuid": None},
            after,
            limit,
        )

    records_to_write: list[dict[str, Any]] = []
    if entries_to_scan:
        scan_input, line_to_entry = build_scan_input(entries_to_scan)
        findings = run_betterleaks(scan_input)
        grouped_findings = findings_by_entry(findings, line_to_entry)
    else:
        grouped_findings = {}

    for entry, findings in grouped_findings.values():
        record = report_record(entry, findings)
        records_to_write.append(record)
        types = ", ".join(record["finding_types"])
        print(f"命中敏感历史。uuid={entry.uuid} type={types}")

        if len(records_to_write) == 1:
            notify(f"发现 Atuin 历史里可能有敏感信息。uuid={entry.uuid}")

    append_jsonl(findings_path, records_to_write)

    state.update(
        {
            "latest_scanned_at": datetime.now().astimezone().isoformat(timespec="seconds"),
            "latest_scanned_uuid": latest_uuid,
            "latest_scanned_time": latest_time,
            "last_entry_count": len(entries),
            "last_finding_count": len(records_to_write),
            "last_scanned_count": len(entries_to_scan),
        }
    )
    write_json(state_path, state)

    if records_to_write:
        print(f"发现 {len(records_to_write)} 条可疑历史，报告已写入 {findings_path}")
        if is_true("usage_fail_on_findings"):
            return 93
        return 0

    print(f"未发现敏感历史。本次扫描 {len(entries_to_scan)} 条，状态已写入 {state_path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
