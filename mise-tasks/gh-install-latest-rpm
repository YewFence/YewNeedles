#!/usr/bin/env python
#MISE description="在 Fedora/RHEL 系发行版安装单个 GitHub release RPM"
#USAGE arg "<repo>" help="GitHub repository in owner/name form"
#USAGE flag "-p --pattern <pattern>" help="Substring used before automatic architecture filtering when a release has multiple RPMs"
#USAGE flag "--asset-regex <asset_regex>" help="Regex used before automatic architecture filtering when a release has multiple RPMs"
#USAGE flag "-r --retries <retries>" help="Download retry count, defaults to 3"
#USAGE flag "-n --dry-run" help="Show what would be installed without downloading or installing"

from __future__ import annotations

import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SRC = ROOT / "packages" / "gh-release-download" / "src"
sys.path.insert(0, str(SRC))

from gh_release_download import (
    install_release_rpm,
    parse_retry_count,
    require_command,
    require_red_hat_family,
)


def is_true(name: str) -> bool:
    return os.environ.get(name, "false") == "true"


def usage_value(name: str, default: str = "") -> str:
    return os.environ.get(f"usage_{name}", default).strip()


def main() -> int:
    repo = usage_value("repo")
    pattern = usage_value("pattern")
    asset_regex = usage_value("asset_regex")
    retries = parse_retry_count(usage_value("retries"))
    dry_run = is_true("usage_dry_run")

    if not repo:
        print("repo is required", file=sys.stderr)
        return 1

    require_red_hat_family()
    require_command("gh", "Install it with: mise use gh@latest")

    install_release_rpm(
        name=repo,
        repo=repo,
        version=None,
        pattern=pattern,
        asset_regex=asset_regex,
        retries=retries,
        dry_run=dry_run,
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
