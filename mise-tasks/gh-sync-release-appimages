#!/usr/bin/env python
#MISE description="按 apps.toml 同步 GitHub release AppImage"
#USAGE flag "-r --retries <retries>" help="Download retry count, defaults to 3"
#USAGE flag "-a --apps-file <apps_file>" help="Apps file used for sync, defaults to apps.toml"
#USAGE flag "-f --force" help="Install even when the installed AppImage version already matches"
#USAGE flag "-n --dry-run" help="Show what would be installed without downloading"

from __future__ import annotations

import os
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Any

try:
    import tomllib
except ModuleNotFoundError:
    tomllib = None  # type: ignore[assignment]


ROOT = Path(__file__).resolve().parent.parent
SRC = ROOT / "packages" / "gh-release-download" / "src"
sys.path.insert(0, str(SRC))

from gh_release_download import (
    eprint,
    find_gearlever_appimage,
    install_release_appimage,
    parse_retry_count,
    require_command,
)


@dataclass(frozen=True)
class GitHubReleaseAppImage:
    name: str
    repo: str
    version: str
    app_name: str
    asset_pattern: str = ""
    asset_regex: str = ""


def is_true(name: str) -> bool:
    return os.environ.get(name, "false") == "true"


def usage_value(name: str, default: str = "") -> str:
    return os.environ.get(f"usage_{name}", default).strip()


def normalize_version(version: str) -> str:
    normalized = version.strip()
    if len(normalized) > 1 and normalized[0] in {"v", "V"} and normalized[1].isdigit():
        return normalized[1:]
    return normalized


def app_name_from_entry(entry: dict[str, Any], name: str) -> str:
    raw_app_name = entry.get("app_name")
    if isinstance(raw_app_name, str) and raw_app_name:
        return raw_app_name

    return name


def load_apps(path: Path) -> list[GitHubReleaseAppImage]:
    if tomllib is None:
        eprint(
            "Python 3.11 or newer is required to read apps.toml with the standard library tomllib module."
        )
        raise SystemExit(1)

    try:
        raw = tomllib.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        eprint(f"Missing apps file: {path}")
        raise SystemExit(1)
    except tomllib.TOMLDecodeError as error:
        eprint(f"Unable to parse {path}: {error}")
        raise SystemExit(1) from error

    entries = raw.get("github_release_appimages")
    if entries is None:
        return []
    if not isinstance(entries, list):
        eprint(f"{path} must define [[github_release_appimages]] entries.")
        raise SystemExit(1)

    apps: list[GitHubReleaseAppImage] = []
    for index, entry in enumerate(entries, start=1):
        if not isinstance(entry, dict):
            eprint(f"Entry {index} in {path} is not a table.")
            raise SystemExit(1)

        name = entry.get("name")
        repo = entry.get("repo")
        version = entry.get("version")
        raw_app_name = entry.get("app_name")
        asset_pattern = entry.get("asset_pattern", "")
        asset_regex = entry.get("asset_regex", "")
        if not isinstance(name, str) or not name:
            eprint(f"Entry {index} in {path} is missing name.")
            raise SystemExit(1)
        if not isinstance(repo, str) or "/" not in repo:
            eprint(f"{name} in {path} has an invalid repo.")
            raise SystemExit(1)
        if not isinstance(version, str) or not version:
            eprint(f"{name} in {path} is missing version.")
            raise SystemExit(1)
        if raw_app_name is not None and (
            not isinstance(raw_app_name, str) or not raw_app_name
        ):
            eprint(f"{name} in {path} has an invalid app_name.")
            raise SystemExit(1)
        if not isinstance(asset_pattern, str):
            eprint(f"{name} in {path} has a non-string asset_pattern.")
            raise SystemExit(1)
        if not isinstance(asset_regex, str):
            eprint(f"{name} in {path} has a non-string asset_regex.")
            raise SystemExit(1)

        apps.append(
            GitHubReleaseAppImage(
                name=name,
                repo=repo,
                version=version,
                app_name=app_name_from_entry(entry, name),
                asset_pattern=asset_pattern,
                asset_regex=asset_regex,
            )
        )

    return apps


def sync_app(
    app: GitHubReleaseAppImage, *, retries: int, dry_run: bool, force: bool
) -> bool:
    installed = find_gearlever_appimage(app.app_name)
    expected_version = normalize_version(app.version)

    if installed is None:
        print(f"{app.name}: not installed by Gear Lever, install it once first")
        return False

    if installed.version is None:
        eprint(
            f"warning: {app.name}: unable to locate AppImage version for {installed.path}"
        )
        print(f"{app.name}: installed at {installed.path}, version unknown")
    elif normalize_version(installed.version) == expected_version and not force:
        print(f"{app.name}: ok ({installed.version})")
        return False
    else:
        print(f"{app.name}: installed {installed.version}, expected {expected_version}")

    install_release_appimage(
        name=app.name,
        repo=app.repo,
        version=app.version,
        app_name=app.app_name,
        target_path=installed.path,
        desktop_file=installed.desktop_file,
        pattern=app.asset_pattern,
        asset_regex=app.asset_regex,
        retries=retries,
        dry_run=dry_run,
    )
    return True


def main() -> int:
    retries = parse_retry_count(usage_value("retries"))
    apps_file = Path(usage_value("apps_file", "apps.toml"))
    dry_run = is_true("usage_dry_run")
    force = is_true("usage_force")

    require_command("gh", "Install it with: mise use gh@latest")

    updated_apps: list[str] = []
    for app in load_apps(apps_file):
        if sync_app(app, retries=retries, dry_run=dry_run, force=force):
            updated_apps.append(app.name)

    if updated_apps:
        print("These apps may need a restart:")
        for name in updated_apps:
            print(name)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
