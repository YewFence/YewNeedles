#!/usr/bin/env python3
#USAGE flag "--all" help="包含当前配置中尚未安装的工具"
#USAGE flag "-J --json" help="输出 JSON"
#USAGE flag "-r --refresh" help="刷新包元数据和 aqua registry 缓存"

from __future__ import annotations

import csv
import hashlib
import json
import os
import subprocess
import sys
import tempfile
import time
from concurrent.futures import ThreadPoolExecutor
from html.parser import HTMLParser
from pathlib import Path
from urllib.parse import quote, urlsplit, urlunsplit
from urllib.request import Request, urlopen


CACHE_TTL = 86400
CACHE_ROOT = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache")
CORE_REPOSITORIES = {
    "bun": "oven-sh/bun",
    "go": "golang/go",
    "java": "openjdk/jdk",
    "node": "nodejs/node",
    "python": "python/cpython",
    "rust": "rust-lang/rust",
}
CORE_DOCS = {
    name: f"https://mise.jdx.dev/lang/{name}.html"
    for name in ("bun", "deno", "dotnet", "elixir", "erlang", "go", "java", "node", "python", "ruby", "rust", "swift", "zig")
}
SOURCE_LABELS = {"source", "source code", "sourcecode", "repository", "code", "github", "gitlab"}
HOME_LABELS = {"homepage", "home page", "home"}


def run_command(*args: str) -> str:
    result = subprocess.run(args, capture_output=True, text=True, timeout=45)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or f"command failed: {' '.join(args)}")
    return result.stdout


def clean_url(value: object, *, repository: bool = False) -> str | None:
    if not isinstance(value, str) or not value.strip():
        return None
    value = value.strip().removeprefix("git+")
    if value.startswith("git@") and ":" in value:
        host, path = value[4:].split(":", 1)
        value = f"https://{host}/{path}"
    parsed = urlsplit(value)
    if parsed.scheme in {"git", "ssh"}:
        parsed = parsed._replace(scheme="https", netloc=parsed.hostname or "")
    if parsed.scheme not in {"http", "https"} or not parsed.hostname:
        return None
    if repository:
        parsed = parsed._replace(path=parsed.path.rstrip("/").removesuffix(".git"), fragment="")
    return urlunsplit(parsed)


def metadata_links(kind: str, data: dict) -> tuple[str | None, str | None]:
    if kind == "npm":
        repo = data.get("repository")
        if isinstance(repo, dict):
            repo = repo.get("url")
        return clean_url(data.get("homepage")), clean_url(repo, repository=True)
    if kind == "cargo":
        crate = data["crate"]
        return clean_url(crate.get("homepage")), clean_url(crate.get("repository"), repository=True)
    info = data["info"]
    links = {(label.lower().replace("_", " ").strip()): url for label, url in (info.get("project_urls") or {}).items()}
    home = next((clean_url(url) for label, url in links.items() if label in HOME_LABELS and clean_url(url)), None)
    repo = next((clean_url(url, repository=True) for label, url in links.items() if label in SOURCE_LABELS and clean_url(url)), None)
    return home or clean_url(info.get("home_page")), repo


def fetch_json(url: str, refresh: bool) -> dict:
    path = CACHE_ROOT / "mise" / "tool-links" / f"{hashlib.sha256(url.encode()).hexdigest()}.json"
    if not refresh and path.is_file() and time.time() - path.stat().st_mtime < CACHE_TTL:
        return json.loads(path.read_text(encoding="utf-8"))
    request = Request(url, headers={"Accept": "application/json", "User-Agent": "mise-tool-links/1.0"})
    with urlopen(request, timeout=15) as response:
        data = json.load(response)
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=path.parent, delete=False) as temporary:
        json.dump(data, temporary, ensure_ascii=False)
    Path(temporary.name).replace(path)
    return data


def aqua_packages(refresh: bool) -> dict[str, dict]:
    path = CACHE_ROOT / "aqua-search" / "registry.yaml"
    if refresh or not path.is_file() or time.time() - path.stat().st_mtime >= CACHE_TTL:
        raw = run_command("gh", "api", "repos/aquaproj/aqua-registry/contents/registry.yaml", "-H", "Accept: application/vnd.github.raw+json")
        parsed = json.loads(run_command_with_input(raw, "yq", "-p=yaml", "-o=json", "."))
        packages = parsed["packages"]
        path.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=path.parent, delete=False) as temporary:
            temporary.write(raw)
        Path(temporary.name).replace(path)
    else:
        packages = json.loads(run_command("yq", "-o=json", ".packages", str(path)))
    return {package.get("name") or f"{package.get('repo_owner')}/{package.get('repo_name')}": package for package in packages}


def run_command_with_input(text: str, *args: str) -> str:
    result = subprocess.run(args, input=text, capture_output=True, text=True, timeout=45)
    if result.returncode:
        raise RuntimeError(result.stderr.strip())
    return result.stdout


class GoImportParser(HTMLParser):
    def __init__(self):
        super().__init__()
        self.imports: list[tuple[str, str]] = []

    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        if tag == "meta" and attrs.get("name") == "go-import":
            parts = (attrs.get("content") or "").split()
            if len(parts) == 3 and parts[1] != "mod":
                self.imports.append((parts[0], parts[2]))


def go_repository(module: str) -> str | None:
    parts = module.split("/")
    if parts[0] in {"github.com", "bitbucket.org"} and len(parts) >= 3:
        return f"https://{'/'.join(parts[:3])}"
    request = Request(f"https://{module}?go-get=1", headers={"User-Agent": "mise-tool-links/1.0"})
    with urlopen(request, timeout=15) as response:
        text = response.read().decode("utf-8")
    parser = GoImportParser()
    parser.feed(text)
    for prefix, repo in sorted(parser.imports, key=lambda item: len(item[0]), reverse=True):
        if module == prefix or module.startswith(prefix + "/"):
            return clean_url(repo, repository=True)
    return None


def tool_info(tool: str) -> dict:
    if ":" in tool and not tool.startswith(("forgejo:", "gitlab:")):
        return {"backend": tool, "url": None}
    return json.loads(run_command("mise", "tool", "--json", tool))


def aqua_links(package: str, aqua: dict[str, dict]) -> tuple[str | None, str | None]:
    entry = aqua.get(package)
    if not entry:
        return None, None
    repo = None
    if entry.get("repo_owner") and entry.get("repo_name"):
        repo = f"https://github.com/{entry['repo_owner']}/{entry['repo_name']}"
    elif entry.get("path"):
        repo = go_repository(entry["path"])
    return clean_url(entry.get("link")), repo


def resolve(row: dict, aqua: dict[str, dict], refresh: bool, registry: dict | None = None) -> dict:
    try:
        info = tool_info(row["tool"])
        row["backend"] = info["backend"]
        row["project_url"] = clean_url(info.get("url"))
        backend, _, package = info["backend"].partition(":")
        row["sources"].append("mise tool" if ":" not in row["tool"] else "backend identifier")
        repo = None
        if backend == "github":
            repo = f"https://github.com/{package}"
        elif backend in {"forgejo", "gitlab"}:
            defaults = {"forgejo": "https://codeberg.org/api/v1", "gitlab": "https://gitlab.com/api/v4"}
            api_url = (info.get("tool_options") or {}).get("api_url") or defaults[backend]
            parsed = urlsplit(api_url)
            repo = urlunsplit((parsed.scheme, parsed.netloc, f"/{package}", "", ""))
        elif backend == "packslip":
            if "." not in package.split("/", 1)[0]:
                package = "github.com/" + package
            if package.startswith("github.com/"):
                repo = "https://" + "/".join(package.split("/")[:3])
            else:
                row["homepage"] = clean_url("https://" + package)
        elif backend == "aqua":
            row["homepage"], repo = aqua_links(package, aqua)
            row["sources"].append("aqua registry")
        elif backend in {"asdf", "vfox"}:
            row["plugin_repository"] = clean_url(package, repository=True) or f"https://github.com/{package}"
            for candidate in (registry or {}).get(row["tool"], {}).get("backends", []):
                if candidate.startswith("aqua:"):
                    row["homepage"], repo = aqua_links(candidate.partition(":")[2], aqua)
                    if row["homepage"] or repo:
                        row["sources"].append("mise registry project candidate: " + candidate)
                        break
                elif candidate.startswith("github:"):
                    repo = "https://github.com/" + candidate.partition(":")[2]
                    row["sources"].append("mise registry project candidate: " + candidate)
                    break
        elif backend == "core":
            row["mise_docs"] = CORE_DOCS.get(package)
            core_repo = CORE_REPOSITORIES.get(package)
            if core_repo:
                args = ["gh", "api", f"repos/{core_repo}"]
                if not refresh:
                    args += ["--cache", "24h"]
                data = json.loads(run_command(*args))
                row["homepage"] = clean_url(data.get("homepage"))
                repo = data["html_url"]
                row["sources"].append("core upstream: " + core_repo)
                row["sources"].append("GitHub repository metadata")
        elif backend == "go":
            row["registry"] = f"https://pkg.go.dev/{package}"
            repo = go_repository(package)
            row["sources"].append("Go module path / go-import")
        elif backend in {"cargo", "npm", "pipx", "pypi"}:
            if package.startswith(("https://", "http://", "git+")):
                repo = clean_url(package, repository=True)
            else:
                quoted = quote(package, safe="")
                if backend == "npm":
                    kind, endpoint = "npm", f"https://registry.npmjs.org/{quoted}/latest"
                    row["registry"] = f"https://www.npmjs.com/package/{quote(package, safe='@/')}"
                elif backend == "cargo":
                    kind, endpoint = "cargo", f"https://crates.io/api/v1/crates/{quoted}"
                    row["registry"] = f"https://crates.io/crates/{quoted}"
                else:
                    kind, endpoint = "pypi", f"https://pypi.org/pypi/{quoted}/json"
                    row["registry"] = f"https://pypi.org/project/{quoted}"
                row["homepage"], repo = metadata_links(kind, fetch_json(endpoint, refresh))
                row["sources"].append(endpoint)
        row["repository"] = clean_url(repo, repository=True)
        if not row["homepage"] and row["project_url"] and backend not in {"core", "asdf", "vfox"}:
            row["homepage"] = row["project_url"]
    except (OSError, RuntimeError, ValueError, KeyError, subprocess.TimeoutExpired) as error:
        row["metadata_error"] = str(error)
    if row["metadata_error"]:
        row["status"] = "error"
    elif row["homepage"] or row["repository"]:
        row["status"] = "ok"
    elif row["plugin_repository"]:
        row["status"] = "plugin-only"
    else:
        row["status"] = "unresolved"
    return row


def load_tools(include_all: bool) -> list[dict]:
    args = ["mise", "ls", "--json"]
    if not include_all:
        args.append("--installed")
    payload = json.loads(run_command(*args))
    rows = []
    for tool, records in payload.items():
        rows.append({
            "tool": tool,
            "versions": list(dict.fromkeys(record["version"] for record in records)),
            "active_versions": [record["version"] for record in records if record.get("active")],
            "backend": tool if ":" in tool else None,
            "homepage": None,
            "repository": None,
            "plugin_repository": None,
            "project_url": None,
            "mise_docs": None,
            "registry": None,
            "sources": [],
            "metadata_error": None,
            "status": "unresolved",
        })
    return rows


def main() -> int:
    include_all = os.environ.get("usage_all") == "true"
    output_json = os.environ.get("usage_json") == "true"
    refresh = os.environ.get("usage_refresh") == "true"
    try:
        rows = load_tools(include_all)
        registry = {entry["short"]: entry for entry in json.loads(run_command("mise", "registry", "--json"))}
        try:
            aqua = aqua_packages(refresh)
        except (OSError, RuntimeError, ValueError, KeyError, subprocess.TimeoutExpired) as error:
            print(f"mise:tool-links: aqua registry: {error}", file=sys.stderr)
            aqua = {}
        with ThreadPoolExecutor(max_workers=8) as executor:
            rows = list(executor.map(lambda row: resolve(row, aqua, refresh, registry), rows))
    except (OSError, RuntimeError, ValueError, subprocess.TimeoutExpired) as error:
        print(f"mise:tool-links: {error}", file=sys.stderr)
        return 1
    rows.sort(key=lambda row: row["tool"].lower())
    if output_json:
        print(json.dumps(rows, ensure_ascii=False, indent=2))
    else:
        writer = csv.writer(sys.stdout, delimiter="\t", lineterminator="\n")
        columns = ["tool", "versions", "backend", "homepage", "repository", "plugin_repository", "project_url", "mise_docs", "registry", "status", "metadata_error"]
        writer.writerow(columns)
        for row in rows:
            writer.writerow([",".join(row[key]) if key == "versions" else row[key] or "" for key in columns])
    missing = sum(row["status"] != "ok" for row in rows)
    print(f"mise:tool-links: {len(rows)} 个工具，{missing} 个需进一步确认", file=sys.stderr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
