#!/usr/bin/env python
# MISE description "在 Fedora/RHEL 系发行版按 tools.toml 同步 GitHub release RPM"
# USAGE flag "-r --retries <retries>" help="Download retry count, defaults to 3"
# USAGE flag "-t --tools-file <tools_file>" help="Tools file used for sync, defaults to tools.toml"
# USAGE flag "-f --force" help="Install even when the installed RPM version already matches"
# USAGE flag "-n --dry-run" help="Show what would be installed without downloading or installing"

from __future__ import annotations

import os
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Any

try:
    import tomllib
except ModuleNotFoundError:
    tomllib = None  # type: ignore[assignment]


ROOT = Path(__file__).resolve().parent.parent
SRC = ROOT / "packages" / "gh-release-rpm" / "src"
sys.path.insert(0, str(SRC))

from gh_release_rpm import (
    eprint,
    install_release_rpm,
    parse_retry_count,
    require_command,
    require_red_hat_family,
)


@dataclass(frozen=True)
class GithubReleaseRpm:
    name: str
    repo: str
    version: str
    package_names: tuple[str, ...]
    asset_pattern: str = ""


def is_true(name: str) -> bool:
    return os.environ.get(name, "false") == "true"


def usage_value(name: str, default: str = "") -> str:
    return os.environ.get(f"usage_{name}", default).strip()


def command_output(
    args: list[str], *, allow_failure: bool = False
) -> tuple[int, str, str]:
    import subprocess

    result = subprocess.run(
        args,
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode != 0 and not allow_failure:
        error = result.stderr.strip() or result.stdout.strip() or "command failed"
        eprint(error)
        raise SystemExit(result.returncode)

    return result.returncode, result.stdout, result.stderr


def normalize_version(version: str) -> str:
    normalized = version.strip()
    if len(normalized) > 1 and normalized[0] in {"v", "V"} and normalized[1].isdigit():
        return normalized[1:]
    return normalized


def rpm_query_version(package_name: str) -> str | None:
    code, stdout, _ = command_output(
        ["rpm", "-q", "--qf", "%{VERSION}\n", package_name],
        allow_failure=True,
    )
    if code != 0:
        return None

    version = stdout.strip().splitlines()[0] if stdout.strip() else ""
    return version or None


def installed_version(package_names: tuple[str, ...]) -> tuple[str, str] | None:
    for package_name in package_names:
        version = rpm_query_version(package_name)
        if version is not None:
            return package_name, version

    return None


def package_names_from_entry(entry: dict[str, Any], name: str) -> tuple[str, ...]:
    raw_package_names = entry.get("package_names")
    if isinstance(raw_package_names, list):
        package_names = tuple(
            item for item in raw_package_names if isinstance(item, str) and item
        )
        if package_names:
            return package_names

    raw_package = entry.get("package")
    if isinstance(raw_package, str) and raw_package:
        return (raw_package,)

    return (name,)


def load_tools(path: Path) -> list[GithubReleaseRpm]:
    if tomllib is None:
        eprint(
            "Python 3.11 or newer is required to read tools.toml with the standard library tomllib module."
        )
        raise SystemExit(1)

    try:
        raw = tomllib.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        eprint(f"Missing tools file: {path}")
        raise SystemExit(1)
    except tomllib.TOMLDecodeError as error:
        eprint(f"Unable to parse {path}: {error}")
        raise SystemExit(1) from error

    entries = raw.get("github_release_rpms")
    if not isinstance(entries, list):
        eprint(f"{path} must define [[github_release_rpms]] entries.")
        raise SystemExit(1)

    tools: list[GithubReleaseRpm] = []
    for index, entry in enumerate(entries, start=1):
        if not isinstance(entry, dict):
            eprint(f"Entry {index} in {path} is not a table.")
            raise SystemExit(1)

        name = entry.get("name")
        repo = entry.get("repo")
        version = entry.get("version")
        asset_pattern = entry.get("asset_pattern", "")
        if not isinstance(name, str) or not name:
            eprint(f"Entry {index} in {path} is missing name.")
            raise SystemExit(1)
        if not isinstance(repo, str) or "/" not in repo:
            eprint(f"{name} in {path} has an invalid repo.")
            raise SystemExit(1)
        if not isinstance(version, str) or not version:
            eprint(f"{name} in {path} is missing version.")
            raise SystemExit(1)
        if not isinstance(asset_pattern, str):
            eprint(f"{name} in {path} has a non-string asset_pattern.")
            raise SystemExit(1)

        tools.append(
            GithubReleaseRpm(
                name=name,
                repo=repo,
                version=version,
                package_names=package_names_from_entry(entry, name),
                asset_pattern=asset_pattern,
            )
        )

    return tools


def sync_tool(
    tool: GithubReleaseRpm, *, retries: int, dry_run: bool, force: bool
) -> bool:
    expected_version = normalize_version(tool.version)
    installed = installed_version(tool.package_names)

    if installed is None:
        package_label = ", ".join(tool.package_names)
        print(f"{tool.name}: not installed as any of [{package_label}]")
    else:
        package_name, current_version = installed
        if normalize_version(current_version) == expected_version and not force:
            print(f"{tool.name}: ok ({package_name} {current_version})")
            return False

        print(
            f"{tool.name}: installed {package_name} {current_version}, expected {expected_version}"
        )

    install_release_rpm(
        name=tool.name,
        repo=tool.repo,
        version=tool.version,
        pattern=tool.asset_pattern,
        retries=retries,
        dry_run=dry_run,
    )
    return True


def main() -> int:
    retries = parse_retry_count(usage_value("retries"))
    tools_file = Path(usage_value("tools_file", "tools.toml"))
    dry_run = is_true("usage_dry_run")
    force = is_true("usage_force")

    require_red_hat_family()
    require_command("gh", "Install it with: mise use gh@latest")
    require_command("rpm")

    updated_tools: list[str] = []
    for tool in load_tools(tools_file):
        if sync_tool(tool, retries=retries, dry_run=dry_run, force=force):
            updated_tools.append(tool.name)

    if updated_tools:
        print("These tools may need a restart:")
        for name in updated_tools:
            print(name)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
