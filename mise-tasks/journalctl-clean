#!/usr/bin/env python
#MISE description="Clean pasted journalctl lines by removing the syslog timestamp and hostname prefix"

from __future__ import annotations

import os
import re
import select
import sys

END_MARKERS = {".", "EOF"}
PASTE_IDLE_SECONDS = 0.35

JOURNALCTL_PREFIX = re.compile(
    r"^(?:[A-Z][a-z]{2})\s+"
    r"\d{1,2}\s+"
    r"\d{2}:\d{2}:\d{2}\s+"
    r"\S+\s+"
)


def clean_line(line: str) -> str:
    return JOURNALCTL_PREFIX.sub("", line, count=1)


def clean_text(text: str) -> list[str]:
    cleaned_lines: list[str] = []

    for line in text.splitlines():
        if line.strip() in END_MARKERS:
            break
        cleaned_lines.append(clean_line(line))

    return cleaned_lines


def read_interactive_paste() -> str:
    chunks: list[bytes] = []
    fd = sys.stdin.fileno()

    while True:
        timeout = PASTE_IDLE_SECONDS if chunks else None
        ready, _, _ = select.select([sys.stdin], [], [], timeout)
        if not ready:
            break

        chunk = os.read(fd, 65536)
        if not chunk:
            break

        chunks.append(chunk)
        text = b"".join(chunks).decode("utf-8", errors="replace")
        if any(line.strip() in END_MARKERS for line in text.splitlines()):
            break

    return b"".join(chunks).decode("utf-8", errors="replace")


def main() -> int:
    should_prompt = sys.stdin.isatty()
    if should_prompt:
        print(
            "粘贴整段 journalctl 日志后停顿一下会自动清洗，也可以把单独一行 . 或 EOF 一起粘贴进去立即结束。",
            file=sys.stderr,
        )
        text = read_interactive_paste()
    else:
        text = sys.stdin.read()

    for line in clean_text(text):
        print(line)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
