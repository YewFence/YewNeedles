#!/usr/bin/env python
# MISE description "Approve skipped dependency builds for a mise npm:* tool installed via pnpm"
# USAGE arg "<tool>" help="Installed npm tool name or full mise spec, e.g. @larksuite/cli or npm:@larksuite/cli"
# USAGE flag "--all" help="Approve all ignored builds without prompting"
# USAGE flag "-r --rebuild" help="Run pnpm install after approval to execute approved builds"
# USAGE flag "-n --dry-run" help="Resolve paths and show ignored builds without approving"

from __future__ import annotations

import os
import shutil
import subprocess
import sys
from pathlib import Path


def eprint(message: str) -> None:
    print(message, file=sys.stderr)


def is_true(name: str) -> bool:
    return os.environ.get(name, "false") == "true"


def normalize_tool_spec(tool_input: str) -> str:
    if tool_input.startswith("npm:"):
        return tool_input
    return f"npm:{tool_input}"


def run_streaming(args: list[str]) -> None:
    sys.stdout.flush()
    sys.stderr.flush()
    result = subprocess.run(args, check=False)
    if result.returncode != 0:
        raise SystemExit(result.returncode)


def resolve_install_dir(tool_spec: str) -> Path:
    result = subprocess.run(
        ["mise", "where", tool_spec],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
    )
    if result.returncode != 0:
        eprint(
            f"Unable to resolve '{tool_spec}'. Install it first or pass the exact installed npm: tool name."
        )
        raise SystemExit(1)

    install_dir = result.stdout.strip()
    if not install_dir:
        eprint(
            f"Unable to resolve '{tool_spec}'. Install it first or pass the exact installed npm: tool name."
        )
        raise SystemExit(1)

    return Path(install_dir)


def is_pnpm_project_dir(entry: Path) -> bool:
    return (entry / "package.json").is_file() and (entry / "pnpm-lock.yaml").is_file()


def has_pnpm_install_state(entry: Path) -> bool:
    return (
        (entry / "node_modules" / ".modules.yaml").is_file()
        or (entry / ".pnpm").is_dir()
        or (entry / "node_modules" / ".pnpm").is_dir()
    )


def resolve_pnpm_project_dir(install_dir: Path) -> Path | None:
    candidates: list[Path] = []

    if is_pnpm_project_dir(install_dir):
        candidates.append(install_dir)

    for entry in sorted(install_dir.iterdir(), key=lambda item: item.name):
        if entry.is_dir() and is_pnpm_project_dir(entry):
            candidates.append(entry)

    if len(candidates) == 1:
        return candidates[0].resolve(strict=True)

    stateful_candidates = [
        entry for entry in candidates if has_pnpm_install_state(entry)
    ]
    if len(stateful_candidates) == 1:
        return stateful_candidates[0].resolve(strict=True)

    return None


def main() -> None:
    tool_input = os.environ["usage_tool"]
    tool_spec = normalize_tool_spec(tool_input)

    if shutil.which("pnpm") is None:
        eprint("pnpm is not on PATH. Install it with: mise use pnpm@latest")
        raise SystemExit(1)

    install_dir = resolve_install_dir(tool_spec)

    approve_dir = resolve_pnpm_project_dir(install_dir)
    if approve_dir is None:
        eprint(f"Could not find a pnpm project under '{install_dir}'.")
        eprint("This task only applies to npm tools installed by mise through pnpm.")
        raise SystemExit(1)

    print(f"tool: {tool_spec}")
    print(f"install dir: {install_dir}")
    print(f"pnpm project: {approve_dir}")
    print()

    run_streaming(["pnpm", "--dir", str(approve_dir), "ignored-builds"])

    if is_true("usage_dry_run"):
        return

    approve_args = ["pnpm", "--dir", str(approve_dir), "approve-builds"]
    if is_true("usage_all"):
        approve_args.append("--all")
    run_streaming(approve_args)

    if is_true("usage_rebuild"):
        # Mise's npm shims point at <project>/.pnpm, while pnpm normally reinstalls
        # into node_modules/.pnpm. Keep the virtual store where the shim loads from.
        run_streaming(
            [
                "pnpm",
                "--dir",
                str(approve_dir),
                "install",
                "--force",
                "--offline",
                "--frozen-lockfile",
                "--ignore-scripts=false",
                "--virtual-store-dir",
                ".pnpm",
                "--config.confirm-modules-purge=false",
            ]
        )
        return

    print()
    print("Re-run with --rebuild if you want the approved scripts to execute now.")


if __name__ == "__main__":
    main()
