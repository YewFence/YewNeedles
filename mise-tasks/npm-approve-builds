#!/usr/bin/env bash
#MISE description "Approve skipped dependency builds for a mise npm:* tool installed via aube"
#USAGE arg "<tool>" help="Installed npm tool name or full mise spec, e.g. @larksuite/cli or npm:@larksuite/cli"
#USAGE flag "--all" help="Approve all ignored builds without prompting"
#USAGE flag "-r --rebuild" help="Run aube rebuild after approval"
#USAGE flag "-n --dry-run" help="Resolve paths and show ignored builds without approving"

set -euo pipefail

tool_input="${usage_tool?}"
tool_spec="$tool_input"

if [[ "$tool_spec" != npm:* ]]; then
  tool_spec="npm:$tool_spec"
fi

if ! command -v aube >/dev/null 2>&1; then
  echo "aube is not on PATH. Install it with: mise use aube@latest" >&2
  exit 1
fi

if ! install_dir="$(mise where "$tool_spec" 2>/dev/null)"; then
  echo "Unable to resolve '$tool_spec'. Install it first or pass the exact installed npm: tool name." >&2
  exit 1
fi

global_aube_dir="$install_dir/global-aube"
if [[ ! -d "$global_aube_dir" ]]; then
  echo "'$tool_spec' is installed at '$install_dir', but there is no global-aube directory." >&2
  echo "This task only applies to npm tools installed by mise through aube." >&2
  exit 1
fi

resolve_approve_dir() {
  local dir="$1"
  local entry

  while IFS= read -r entry; do
    if [[ -L "$entry" && -f "$entry/package.json" ]]; then
      readlink -f "$entry"
      return 0
    fi
  done < <(find "$dir" -mindepth 1 -maxdepth 1 -type l | sort)

  while IFS= read -r entry; do
    if [[ -d "$entry" && -f "$entry/package.json" && -f "$entry/aube-lock.yaml" ]]; then
      readlink -f "$entry"
      return 0
    fi
  done < <(find "$dir" -mindepth 1 -maxdepth 1 -type d | sort)

  return 1
}

if ! approve_dir="$(resolve_approve_dir "$global_aube_dir")"; then
  echo "Could not find an aube project under '$global_aube_dir'." >&2
  exit 1
fi

echo "tool: $tool_spec"
echo "install dir: $install_dir"
echo "aube project: $approve_dir"
echo

aube ignored-builds --dir "$approve_dir"

if [[ "${usage_dry_run:-false}" == "true" ]]; then
  exit 0
fi

approve_args=(approve-builds --dir "$approve_dir")
if [[ "${usage_all:-false}" == "true" ]]; then
  approve_args+=(--all)
fi

aube "${approve_args[@]}"

if [[ "${usage_rebuild:-false}" == "true" ]]; then
  aube rebuild --dir "$approve_dir"
else
  echo
  echo "Re-run with --rebuild if you want the approved scripts to execute now."
fi
