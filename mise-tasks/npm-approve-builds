#!/usr/bin/env python
#MISE description "Approve skipped dependency builds for a mise npm:* tool installed via aube"
#USAGE arg "<tool>" help="Installed npm tool name or full mise spec, e.g. @larksuite/cli or npm:@larksuite/cli"
#USAGE flag "--all" help="Approve all ignored builds without prompting"
#USAGE flag "-r --rebuild" help="Run aube rebuild after approval"
#USAGE flag "-n --dry-run" help="Resolve paths and show ignored builds without approving"

from __future__ import annotations

import os
import shutil
import subprocess
import sys
from pathlib import Path


def eprint(message: str) -> None:
    print(message, file=sys.stderr)


def is_true(name: str) -> bool:
    return os.environ.get(name, "false") == "true"


def normalize_tool_spec(tool_input: str) -> str:
    if tool_input.startswith("npm:"):
        return tool_input
    return f"npm:{tool_input}"


def run_streaming(args: list[str]) -> None:
    result = subprocess.run(args, check=False)
    if result.returncode != 0:
        raise SystemExit(result.returncode)


def resolve_install_dir(tool_spec: str) -> Path:
    result = subprocess.run(
        ["mise", "where", tool_spec],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
    )
    if result.returncode != 0:
        eprint(
            f"Unable to resolve '{tool_spec}'. Install it first or pass the exact installed npm: tool name."
        )
        raise SystemExit(1)

    install_dir = result.stdout.strip()
    if not install_dir:
        eprint(
            f"Unable to resolve '{tool_spec}'. Install it first or pass the exact installed npm: tool name."
        )
        raise SystemExit(1)

    return Path(install_dir)


def is_link_like(entry: Path) -> bool:
    try:
        if entry.is_symlink():
            return True

        resolved = entry.resolve(strict=True)
    except OSError:
        return False

    absolute = Path(os.path.abspath(entry))
    return os.path.normcase(str(resolved)) != os.path.normcase(str(absolute))


def resolve_approve_dir(global_aube_dir: Path) -> Path | None:
    entries = sorted(global_aube_dir.iterdir(), key=lambda entry: entry.name)

    # Prefer linked entries first so the task behaves like the original shell version.
    for entry in entries:
        if is_link_like(entry) and (entry / "package.json").is_file():
            return entry.resolve(strict=True)

    for entry in entries:
        if (
            entry.is_dir()
            and (entry / "package.json").is_file()
            and (entry / "aube-lock.yaml").is_file()
        ):
            return entry.resolve(strict=True)

    return None


def main() -> None:
    tool_input = os.environ["usage_tool"]
    tool_spec = normalize_tool_spec(tool_input)

    if shutil.which("aube") is None:
        eprint("aube is not on PATH. Install it with: mise use aube@latest")
        raise SystemExit(1)

    install_dir = resolve_install_dir(tool_spec)
    global_aube_dir = install_dir / "global-aube"

    if not global_aube_dir.is_dir():
        eprint(f"'{tool_spec}' is installed at '{install_dir}', but there is no global-aube directory.")
        eprint("This task only applies to npm tools installed by mise through aube.")
        raise SystemExit(1)

    approve_dir = resolve_approve_dir(global_aube_dir)
    if approve_dir is None:
        eprint(f"Could not find an aube project under '{global_aube_dir}'.")
        raise SystemExit(1)

    print(f"tool: {tool_spec}")
    print(f"install dir: {install_dir}")
    print(f"aube project: {approve_dir}")
    print()

    run_streaming(["aube", "ignored-builds", "--dir", str(approve_dir)])

    if is_true("usage_dry_run"):
        return

    approve_args = ["aube", "approve-builds", "--dir", str(approve_dir)]
    if is_true("usage_all"):
        approve_args.append("--all")
    run_streaming(approve_args)

    if is_true("usage_rebuild"):
        run_streaming(["aube", "rebuild", "--dir", str(approve_dir)])
        return

    print()
    print("Re-run with --rebuild if you want the approved scripts to execute now.")


if __name__ == "__main__":
    main()
