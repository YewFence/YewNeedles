#!/usr/bin/env python
#MISE description "Run gh auth setup-git against ~/.gitconfig.local and warn if ~/.gitconfig does not include it"

from __future__ import annotations

import os
import shutil
import subprocess
import sys
from pathlib import Path


def eprint(message: str) -> None:
    print(message, file=sys.stderr)


def require_command(name: str) -> None:
    if shutil.which(name) is None:
        eprint(f"{name} is not on PATH.")
        raise SystemExit(1)


def display_path(path: Path, *, home: Path) -> str:
    try:
        relative = path.relative_to(home)
    except ValueError:
        return str(path)

    return str(Path("~") / relative).replace("\\", "/")


def normalize_path(raw_path: str, *, base_dir: Path) -> str:
    candidate = Path(os.path.expanduser(raw_path))
    if not candidate.is_absolute():
        candidate = base_dir / candidate

    return os.path.normcase(os.path.abspath(str(candidate)))


def run_setup_git(local_gitconfig: Path) -> None:
    env = os.environ.copy()
    env["GIT_CONFIG_GLOBAL"] = str(local_gitconfig)

    result = subprocess.run(
        ["gh", "auth", "setup-git"],
        check=False,
        env=env,
    )
    if result.returncode != 0:
        raise SystemExit(result.returncode)


def read_include_paths(global_gitconfig: Path) -> list[str]:
    result = subprocess.run(
        [
            "git",
            "config",
            "--file",
            str(global_gitconfig),
            "--get-regexp",
            r"^(include|includeIf\..*)\.path$",
        ],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )

    if result.returncode == 1 and not result.stderr.strip():
        return []

    if result.returncode != 0:
        error = result.stderr.strip() or "git config failed."
        eprint(f"Unable to inspect '{global_gitconfig}': {error}")
        raise SystemExit(result.returncode)

    paths: list[str] = []
    for line in result.stdout.splitlines():
        parts = line.split(None, 1)
        if len(parts) == 2:
            paths.append(parts[1].strip())

    return paths


def has_include(global_gitconfig: Path, local_gitconfig: Path) -> bool:
    expected = normalize_path(str(local_gitconfig), base_dir=global_gitconfig.parent)

    for include_path in read_include_paths(global_gitconfig):
        if normalize_path(include_path, base_dir=global_gitconfig.parent) == expected:
            return True

    return False


def warn_if_missing_include(global_gitconfig: Path, local_gitconfig: Path, *, home: Path) -> None:
    display_global = display_path(global_gitconfig, home=home)
    display_local = display_path(local_gitconfig, home=home)

    if not global_gitconfig.is_file():
        eprint(f"WARN: {display_global} does not exist, so it cannot include {display_local}.")
        return

    if has_include(global_gitconfig, local_gitconfig):
        return

    eprint(f"WARN: {display_global} does not include {display_local}.")


def main() -> None:
    require_command("gh")
    require_command("git")

    home = Path.home()
    global_gitconfig = home / ".gitconfig"
    local_gitconfig = home / ".gitconfig.local"

    run_setup_git(local_gitconfig)
    warn_if_missing_include(global_gitconfig, local_gitconfig, home=home)


if __name__ == "__main__":
    main()
