#!/usr/bin/env python
#MISE description "Scan ~/.zsh_history with gitleaks and delete lines that contain secrets"
#USAGE flag "--history <path>" help="History file to clean, defaults to ~/.zsh_history"
#USAGE flag "-n --dry-run" help="Only show how many lines would be deleted"
#USAGE flag "--timeout <seconds>" help="Timeout passed to gitleaks, defaults to 0"

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any


LEAK_EXIT_CODE = 93


def eprint(message: str) -> None:
    print(message, file=sys.stderr)


def is_true(name: str) -> bool:
    return os.environ.get(name, "false") == "true"


def usage_value(name: str, default: str = "") -> str:
    return os.environ.get(f"usage_{name}", default).strip()


def history_path() -> Path:
    value = usage_value("history", "~/.zsh_history")
    return Path(value).expanduser()


def require_command(name: str, install_hint: str) -> None:
    if shutil.which(name) is not None:
        return

    eprint(f"{name} 不在 PATH 里。{install_hint}")
    raise SystemExit(1)


def run_gitleaks(path: Path, report_path: Path) -> None:
    timeout = usage_value("timeout", "0")
    args = [
        "gitleaks",
        "dir",
        str(path),
        "--no-banner",
        "--no-color",
        "--redact=100",
        "--ignore-gitleaks-allow",
        "--gitleaks-ignore-path",
        str(report_path.parent),
        "--report-format",
        "json",
        "--report-path",
        str(report_path),
        "--exit-code",
        str(LEAK_EXIT_CODE),
    ]

    if timeout:
        args.extend(["--timeout", timeout])

    result = subprocess.run(
        args,
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )

    if result.returncode in {0, LEAK_EXIT_CODE}:
        return

    stdout = result.stdout.strip()
    stderr = result.stderr.strip()
    if stdout:
        eprint(stdout)
    if stderr:
        eprint(stderr)
    raise SystemExit(result.returncode)


def load_findings(report_path: Path) -> list[dict[str, Any]]:
    try:
        raw_report = report_path.read_text(encoding="utf-8")
    except FileNotFoundError:
        return []

    if not raw_report.strip():
        return []

    try:
        data = json.loads(raw_report)
    except json.JSONDecodeError as error:
        eprint(f"无法解析 gitleaks JSON 报告。{error}")
        raise SystemExit(1) from error

    if not isinstance(data, list):
        eprint("gitleaks JSON 报告格式不是数组。")
        raise SystemExit(1)

    findings: list[dict[str, Any]] = []
    for item in data:
        if isinstance(item, dict):
            findings.append(item)
    return findings


def finding_lines(findings: list[dict[str, Any]]) -> set[int]:
    lines: set[int] = set()

    for finding in findings:
        start = finding.get("StartLine")
        end = finding.get("EndLine", start)

        if not isinstance(start, int):
            continue
        if not isinstance(end, int):
            end = start
        if start < 1:
            continue
        if end < start:
            end = start

        lines.update(range(start, end + 1))

    return lines


def rewrite_without_lines(path: Path, deleted_lines: set[int]) -> int:
    original_lines = path.read_bytes().splitlines(keepends=True)
    kept_lines = [
        line for line_number, line in enumerate(original_lines, start=1)
        if line_number not in deleted_lines
    ]

    temp_file = tempfile.NamedTemporaryFile(delete=False, dir=path.parent)
    temp_path = Path(temp_file.name)
    try:
        with temp_file:
            temp_file.write(b"".join(kept_lines))
            temp_file.flush()
            os.fsync(temp_file.fileno())

        shutil.copystat(path, temp_path, follow_symlinks=True)
        temp_path.replace(path)
    except Exception:
        temp_path.unlink(missing_ok=True)
        raise

    return len(original_lines) - len(kept_lines)


def main() -> None:
    require_command(
        "gitleaks",
        "请先执行 MISE_OFFLINE=0 mise install gitleaks 或者 mise install。",
    )

    path = history_path()
    if not path.is_file():
        eprint(f"找不到历史文件。{path}")
        raise SystemExit(1)

    with tempfile.TemporaryDirectory(prefix="gitleaks-zsh-history-") as temp_dir:
        report_path = Path(temp_dir) / "report.json"
        run_gitleaks(path, report_path)
        findings = load_findings(report_path)

    lines = finding_lines(findings)
    if not lines:
        print(f"未发现需要删除的敏感历史行。{path}")
        return

    print(f"gitleaks 命中 {len(findings)} 条发现，将删除 {len(lines)} 行。")

    if is_true("usage_dry_run"):
        print("dry-run 模式未修改文件。")
        return

    deleted_count = rewrite_without_lines(path, lines)
    print(f"已清理 {deleted_count} 行。{path}")


if __name__ == "__main__":
    main()
