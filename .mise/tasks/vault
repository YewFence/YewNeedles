#!/usr/bin/env bash
set -euo pipefail

#MISE description="Manage ansible-vault encrypted variable files"
#USAGE arg "<action>" help="Vault operation" {
#USAGE   choices "create" "edit" "view" "encrypt" "decrypt"
#USAGE }
#USAGE arg "[file]" help="Target file path" default="ansible/group_vars/devboxes_vault.yml"

action="${usage_action:?}"
file="${usage_file:?}"

if [[ "$action" == "create" && -f "$file" ]]; then
  echo "Error: $file already exists. Use 'edit' to modify or 'encrypt' to re-encrypt." >&2
  exit 1
fi

if [[ "$action" == "create" ]]; then
  mkdir -p "$(dirname "$file")"
fi

vault_pass_args=()
for f in .vault_pass .vault_pass.txt .vault-password .vault_password; do
  if [[ -f "$f" ]]; then
    vault_pass_args=(--vault-password-file "$f")
    break
  fi
done

uv run ansible-vault "$action" "${vault_pass_args[@]}" "$file"
