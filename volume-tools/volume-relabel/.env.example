# Copy this file to .env, set VOLUME_NAME and at least one label change, then run:
# docker compose --env-file .env -f compose.yaml run --rm --build relabel

VOLUME_NAME=app_data
VOLUME_LABELS_CLEAR=false
KEEP_BACKUP_VOLUME=false
BACKUP_VOLUME_NAME=
COPY_HELPER_IMAGE=volguard-volume-relabel:local
DOCKER_SOCKET_PATH=/var/run/docker.sock
TZ=Asia/Shanghai

# You can keep using the line-based format.
# VOLUME_LABELS_SET=com.example.owner=ops
# VOLUME_LABELS_REMOVE=com.example.old

# JSON is easier when you want multiple labels in a .env file.
VOLUME_LABELS_SET_JSON={"com.example.owner":"ops","com.example.env":"prod"}
VOLUME_LABELS_REMOVE_JSON=["com.example.old"]
