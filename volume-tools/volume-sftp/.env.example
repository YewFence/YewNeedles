# Copy this file to .env, set VOLUME_NAME, then run:
# docker compose up -d --build sftp

VOLUME_NAME=app_data
VOLUME_READ_ONLY=true

SFTP_BIND_ADDRESS=127.0.0.1
SFTP_PORT=2222
SFTP_USER=volguard
SFTP_UID=1000
SFTP_GID=1000

# Defaults to ${HOME}/.ssh/authorized_keys when unset.
# SFTP_AUTHORIZED_KEY_FILE=/home/you/.ssh/authorized_keys

TZ=UTC
